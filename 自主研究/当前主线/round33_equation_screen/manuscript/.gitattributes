# Paper, source-audit and review hashes refer to exact archived bytes.
# Two trailing spaces are intentional Markdown line breaks in verbatim reviews.
**/*.md -text whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/*.bib -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Frozen typesetting evidence includes TeX, verbatim logs and source diffs.
process/render_complete_v1/** -text whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve the reviewer's frozen terminal blank line and published SHA256.
reviews/full_v1/eic_phase2.md -text whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol

# Unified revision diffs contain literal space-prefixed blank context lines.
process/complete_revised1/*.diff -text whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
process/complete_revised1a/*.diff -text whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
process/delivery_source/*.diff -text whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
